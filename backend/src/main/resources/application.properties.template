# =====================================================================
# application-dev.properties
# Cấu hình cho môi trường DEVELOPMENT — KHÔNG commit file này lên git
# (đã có trong .gitignore)
#
# Cách dùng:
#   1. Copy file này thành application-local.properties
#   2. Sửa giá trị theo môi trường của bạn
#   3. Chạy: mvn spring-boot:run -Dspring-boot.run.profiles=local
# =====================================================================

spring.application.name=backend

# Database - PostgreSQL local
spring.datasource.url=jdbc:postgresql://localhost:5432/postgres
spring.datasource.username=postgres
spring.datasource.password=YOUR_PASSWORD_HERE
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA - validate: chỉ kiểm tra schema, KHÔNG tự sửa
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true

# Flyway
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
spring.flyway.locations=classpath:db/migration

# JWT
# ⚠️ Production PHẢI đổi secret này (>= 32 bytes random)
app.jwt.secret=dev-secret-please-change-this-in-production-it-must-be-at-least-256-bits-long
app.jwt.access-token-expiration=900000           # 15 phút
app.jwt.refresh-token-expiration=604800000       # 7 ngày
app.jwt.issuer=CauLongDee

# OTP
app.otp.length=6
app.otp.ttl-seconds=300
app.otp.max-attempts=5
app.otp.resend-cooldown-seconds=60

# SMS - SpeedSMS.vn
# provider: mock | speedsms
#   mock     → in OTP ra log, KHÔNG gọi mạng, không tốn tiền (dùng cho dev)
#   speedsms → gọi API SpeedSMS thật
# Giá trị khác → app FAIL lúc start (bắt buộc, không fallback im lặng)
app.sms.provider=speedsms
# Lấy access token tại https://speedsms.vn/my-account/api
app.sms.access-token=${SPEEDSMS_ACCESS_TOKEN:}
# Tên brand người gửi — CHỈ dùng khi app.sms.type=3 hoặc 5.
# Brand phải được SpeedSMS duyệt trước, nếu không sẽ bị từ chối.
app.sms.sender=${SPEEDSMS_SENDER:CauLongDee}
# Loại tin: 2=CSKH (không cần brand, hỗ trợ tiếng Việt có dấu)
#           3=brandname (cần brand duyệt, KHÔNG hỗ trợ tiếng Việt có dấu)
#           6=đầu số cố định
app.sms.type=2
# Định dạng số gửi đi: national (0912345678) | e164 (84912345678)
app.sms.phone-format=national
# Tối đa số lần gửi OTP / giờ / IP (chặn đốt tiền tài khoản)
app.sms.max-sends-per-hour-per-ip=10

# Số lần đăng ký tối đa / 1 số điện thoại / 24 giờ (chặn spam tạo account)
app.otp.max-registrations-per-phone-per-day=3

# Số lần thử đăng nhập tối đa / giờ / IP (chặn brute force mật khẩu)
app.auth.max-logins-per-hour-per-ip=10

# CORS
app.cors.allowed-origins=http://localhost:5173,http://localhost:3000

# ----- OAuth2 (Google / Facebook) -----
# Lấy client-id / client-secret từ:
#   Google: https://console.cloud.google.com/apis/credentials
#   Meta:   https://developers.facebook.com/apps
# Để trống → provider bị tắt, frontend ẨN nút tương ứng.
#
# ⚠️ KHÔNG dùng spring.security.oauth2.client.registration.* — Spring Boot 4.1
# ném "Client id of registration 'google' must not be empty" lúc start khi
# client-id rỗng. Ta tự build ClientRegistration trong OAuth2ClientConfig.
app.oauth.google.client-id=${GOOGLE_CLIENT_ID:}
app.oauth.google.client-secret=${GOOGLE_CLIENT_SECRET:}
app.oauth.facebook.client-id=${FACEBOOK_CLIENT_ID:}
app.oauth.facebook.client-secret=${FACEBOOK_CLIENT_SECRET:}

# Graph API version — cập nhật mỗi năm (Meta tăng version 1 lần/năm).
# ⚠️ Mặc định của Spring là v2.8 (đã lỗi thời từ lâu) → PHẢI override.
app.oauth.facebook.graph-version=v27.0

# TTL của ticket (giây) — token hệ thống KHÔNG đi qua URL, chỉ ticket này.
app.oauth.ticket-ttl-seconds=60
# Frontend redirect sau khi OAuth thành công/thất bại.
app.oauth.frontend-redirect-uri=${OAUTH_FRONTEND_REDIRECT_URI:http://localhost:5173}

# ----- Tomcat Session Store -----
# Chỉ định thư mục lưu session riêng trong project.
# Nếu KHÔNG set, Spring Boot dùng %TEMP%\servlet-sessions và có thể
# gặp lỗi "not owned by <user>" (Spring Boot 4.1 kiểm tra quyền sở hữu).
server.servlet.session.store-dir=target/tomcat-sessions
server.servlet.session.persistent=false
